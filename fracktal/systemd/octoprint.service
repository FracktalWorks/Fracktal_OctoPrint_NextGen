[Unit]
Description=OctoPrint (Fracktal Works fork) - web interface and API for the printer
After=network-online.target klipper.service
Wants=network-online.target

[Service]
Environment="LC_ALL=C.UTF-8"
Environment="LANG=C.UTF-8"
Type=exec
User=pi
# The virtualenv path is the same on every Fracktal printer so that ControlCenter's
# launcher and the update scripts can rely on it.
ExecStart=/home/pi/OctoPrint/venv/bin/octoprint serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
